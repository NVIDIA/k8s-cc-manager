# Offline check
# --------------------------------------------------------------------------


def split_prose(document: str) -> tuple[list[str], list[str]]:
    """Return (index rows, section names) found outside fenced license text.

    License texts are reproduced verbatim inside fences and some of them are
    Markdown in their own right, so a plain line scan would pick up a `###`
    heading or a table row belonging to a license rather than to this document.
    Fence state is tracked the way CommonMark closes a fence: a run of backticks
    at least as long as the one that opened it.
    """
    rows: list[str] = []
    sections: list[str] = []
    fence = 0
    for line in document.splitlines():
        if fence:
            match = re.fullmatch(r"(`{3,})\s*", line)
            if match and len(match.group(1)) >= fence:
                fence = 0
            continue
        match = re.fullmatch(r"(`{3,})text", line)
        if match:
            fence = len(match.group(1))
            continue
        if line.startswith("### "):
            sections.append(line[4:].strip())
        elif line.startswith("| `"):
            rows.append(line)
    return rows, sections


def parse_inputs_block(document: str) -> dict[str, str]:
    match = re.search(
        rf"^{re.escape(INPUTS_HEADING)}\n\n```text\n(.*?)\n```$",
        document,
        re.MULTILINE | re.DOTALL,
    )
    if match is None:
        fail(
            f"{rel(OUTPUT)} has no '{INPUTS_HEADING}' block. Regenerate it with "
            "'make -f deployments/container/Makefile notices'."
        )
    recorded: dict[str, str] = {}
    for line in match.group(1).splitlines():
        key, _, value = line.partition(":")
        recorded[key.strip()] = value.strip()
    return recorded


def check(expected: dict[str, str]) -> int:
    """Validate the committed document against the tree, without network."""
    if not OUTPUT.is_file():
        fail(
            f"{rel(OUTPUT)} does not exist. Run 'make -f "
            "deployments/container/Makefile notices' and commit the result."
        )

    document = OUTPUT.read_text(encoding="utf-8")
    recorded = parse_inputs_block(document)

    problems: list[str] = []
    for key in sorted(expected):
        if recorded.get(key) != expected[key]:
            problems.append(
                f"  {key}: recorded {recorded.get(key)!r}, tree has "
                f"{expected[key]!r}"
            )

    # Structural self-consistency: every index row must have a license-text
    # section, every section must carry a version and a license, and no license
    # may be unresolved. This is what stops a truncated or hand-edited document
    # from passing.
    rows, sections = split_prose(document)
    index = []
    for row in rows:
        cells = [cell.strip() for cell in row.strip().strip("|").split("|")]
        if len(cells) != 4:
            problems.append(f"  malformed index row: {row}")
            continue
        index.append(cells)

    if not index:
        problems.append("  index table is empty")

    names = {cells[0].strip("`") for cells in index}
    missing = sorted(names - set(sections))
    extra = sorted(set(sections) - names)
    if missing:
        problems.append(f"  index rows with no license text: {missing}")
    if extra:
        problems.append(f"  license text sections not in the index: {extra}")

    for name, version, license_name, source in index:
        if license_name in ("", "Unknown", SEE_TEXT):
            problems.append(f"  {name}: unresolved license {license_name!r}")
        if not re.match(r"^[0-9]", version):
            problems.append(f"  {name}: implausible version {version!r}")
        if not source:
            problems.append(f"  {name}: index row has no source column")

    for name in sections:
        body = document.split(f"\n### {name}\n", 1)[1].split("\n### ", 1)[0]
        if "```text" not in body:
            problems.append(f"  {name}: section contains no license text")

    if str(len(index)) != recorded.get("distribution-count"):
        problems.append(
            f"  distribution-count: recorded "
            f"{recorded.get('distribution-count')!r}, index has {len(index)} rows"
        )

    if problems:
        print(f"{rel(OUTPUT)} is out of date or inconsistent:", file=sys.stderr)
        for line in problems:
            print(line, file=sys.stderr)
        fail(
            "run 'make -f deployments/container/Makefile notices' and commit the "
            "result."
        )

    print(
        f"{rel(OUTPUT)} is current: {len(index)} distributions, inputs match the "
        "tree."
    )
    return 0


# --------------------------------------------------------------------------


def build_inputs(python_version: str, pins: list[str], released: list[str]) -> dict:
    if not REQUIREMENTS.is_file():
        fail(f"requirements file not found: {REQUIREMENTS}")
    return {
        "requirements": rel(REQUIREMENTS),
        # A digest covers every kind of edit, unlike matching a version string,
        # and needs no network to verify.
        "requirements-sha256": hashlib.sha256(
            REQUIREMENTS.read_bytes()
        ).hexdigest(),
        "python-version": python_version,
        "released-platforms": ", ".join(released),
        "resolution-platform": RESOLUTION_PLATFORM,
        "image-pins": ", ".join(pins) if pins else "none",
    }


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Generate or validate THIRD_PARTY_NOTICES.md."
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Validate the committed file against the tree, offline.",
    )
    args = parser.parse_args()

    python_version, pins = read_dockerfile_inputs()
    released = read_released_platforms()
    inputs = build_inputs(python_version, pins, released)

    if args.check:
        return check(inputs)

    check_environment(python_version)

    work = pathlib.Path(tempfile.mkdtemp(prefix="ccm-notices."))
    try:
        packages = collect(python_version, pins, work)
        check_arch_markers(packages, released)
    finally:
        shutil.rmtree(work, ignore_errors=True)

    # A distribution that ships no license text cannot be attributed from its
    # own artifact, and this document would then carry an entry that says
    # nothing. Fail rather than emit it.
    missing = [p["key"] for p in packages if not p["texts"]]
    if missing:
        for key in missing:
            print(f"  {key}", file=sys.stderr)
        fail(
            "the distributions above ship no license file, so no verbatim text "
            "can be reproduced. Obtain the text from the upstream project and "
            "extend this tool before regenerating."
        )

    unresolved = [p["key"] for p in packages if p["license"] == SEE_TEXT]
    if unresolved:
        for key in unresolved:
            print(f"  {key}", file=sys.stderr)
        fail(
            "the distributions above declare no usable license identifier. Read "
            "their license files and add a ruling to PACKAGE_LICENSE_RULINGS."
        )

    inputs["distribution-count"] = str(len(packages))
    with open(OUTPUT, "w", encoding="utf-8", newline="\n") as handle:
        handle.write(render(packages, inputs))

    print(
        f"Wrote {rel(OUTPUT)} ({len(packages)} distributions)", file=sys.stderr
    )

    # Surfaced, not enforced: which licenses need a compliance decision is not
    # this tool's call, but a reviewer should not have to read 21 sections to
    # find the ones that are not the usual permissive four.
    common = {"Apache-2.0", "MIT", "BSD-3-Clause", "ISC"}
    notable = [p for p in packages if p["license"] not in common]
    if notable:
        print(
            "\nNOTE: these distributions are under something other than "
            "Apache-2.0, MIT,\nBSD-3-Clause or ISC. Confirm they have been "
            "reviewed:",
            file=sys.stderr,
        )
        for pkg in notable:
            print(f"  {pkg['key']} {pkg['version']}: {pkg['license']}",
                  file=sys.stderr)

    return 0


if __name__ == "__main__":
    sys.exit(main())
